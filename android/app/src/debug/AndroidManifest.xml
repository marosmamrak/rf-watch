<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: run the same Car App Library screen on an Android Automotive OS emulator,
     since the Android Auto phone app can't be installed on a phone emulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- app-automotive needs API 29+; it is only ever loaded on the AAOS emulator (API 34). -->
    <uses-sdk tools:overrideLibrary="androidx.car.app.automotive" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application>
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:label="rf-watch (car)"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
