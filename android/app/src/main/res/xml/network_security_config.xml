<?xml version="1.0" encoding="utf-8"?>
<!-- rf-watch nodes are plain-HTTP services on the local network, reached by an arbitrary
     LAN IP address or .local name found over mDNS. Domain-specific configs cannot match
     IP ranges, so cleartext is allowed app-wide. The app only ever connects to node
     addresses the user picked (discovered or typed). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
